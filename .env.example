DJANGO_SECRET_KEY=replace-with-a-50-plus-character-random-secret-before-use
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Leave DATABASE_URL unset for local SQLite; configure PostgreSQL with this value when needed.
# DATABASE_URL=postgresql://brandproof:password@localhost:5432/brandproof
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
# Leave blank to use Vite's local /api proxy and same-origin API in deployment.
VITE_API_URL=
# Optional OpenAI-compatible provider; submitted text is sent externally only when both are configured.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
LLM_EMBEDDING_MODEL=
# Optional SMTP invitation delivery. Without EMAIL_HOST, BrandProof returns a manual invite link.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=brandproof@example.com
PUBLIC_APP_URL=http://localhost:5173
# Optional private S3-compatible file storage (AWS S3, MinIO, or compatible service).
DJANGO_STORAGE_BACKEND=local
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_SERVER_SIDE_ENCRYPTION=AES256
AWS_QUERYSTRING_EXPIRE=300
DEMO_USERNAME=brandproof-demo
# Publicly displayed on the login screen. Create a dedicated demo account first.
DEMO_PASSWORD=
